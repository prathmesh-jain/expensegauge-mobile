# Copy this file to .env and fill in values.
# Note: EXPO_PUBLIC_* values are embedded in the app bundle at build time.
# They should not be treated as secrets.

EXPO_PUBLIC_API_URL=https://{backend-url}/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://expensegauge.prathmeshjain.in/privacy
